d995-9c08-44bb-a4ce-24f334b3670a-unique_selling_point-2":{"type":"unique_selling_point","disabled":true,"settings":{"title":"Not sure which Moonshine?","text":"Try our most popular flavours: Tough Nut, Very Cherry, Wild Berry and Sticky Toffee."}}},"block_order":["template--18043048132876__3633d995-9c08-44bb-a4ce-24f334b3670a-unique_selling_point-1","template--18043048132876__3633d995-9c08-44bb-a4ce-24f334b3670a-unique_selling_point-2"],"settings":{"subheading":"","title":"","background_color_icons":"#ffffff","small_items_per_row":2,"small_items_icon_size":60,"medium_items_per_row":3,"medium_items_icon_size":60,"desktop_items_per_row":4,"desktop_items_icon_size":80,"background_color":"#ffffff","padding_top":0,"padding_bottom":0}},"9a050aa4-61e8-41b9-85db-74a2a0e7cce1":{"type":"featured-product","blocks":{"template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-title-1":{"type":"title","settings":{"heading_size":"h1"}},"template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-text-2":{"type":"text","settings":{"text":"{{ section.settings.product.metafields.descriptors.subtitle.value }}","text_style":"subtitle"}},"template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-price-1":{"type":"price","settings":{}},"template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-variant_picker-1":{"type":"variant_picker","settings":{"picker_type":"dropdown"}},"template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-quantity_selector-1":{"type":"quantity_selector","settings":{}},"template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-buy_buttons-1":{"type":"buy_buttons","settings":{"show_dynamic_checkout":true}}},"block_order":["template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-title-1","template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-text-2","template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-price-1","template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-variant_picker-1","template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-quantity_selector-1","template--18043048132876__9a050aa4-61e8-41b9-85db-74a2a0e7cce1-buy_buttons-1"],"settings":{"is_above_the_fold":false,"product":"tasting-box-1","color_scheme":"background-1","secondary_background":false,"hide_variants":false,"enable_video_looping":false,"padding_top":36,"padding_bottom":16}},"179d69e3-1373-40a2-92ff-f6e68918fbb5":{"type":"multicolumn","blocks":{"template--18049470005516__179d69e3-1373-40a2-92ff-f6e68918fbb5-column-2":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/HarteNuss_50_UK_d90b8328-1f69-42a2-bd8b-fb20c3775be5.jpg","title":"Tough Nut","text":"<p>Tough Nut is an all time favourite. Hazelnut and fine caramel notes paired with a hint of nougat will remind you of a famous chocolate treat.<\/p>","link_label":"","link":""}},"template--18049470005516__179d69e3-1373-40a2-92ff-f6e68918fbb5-column-3":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/PralleKirsche_50_UK_1.jpg","title":"Very Cherry","text":"<p>Our Very Cherry tastes like freshly picked cherries from the garden and has an unmistakable flavour. If you're a fan of cherries, this is not one to miss!<\/p>","link_label":"","link":""}},"87c4baff-6a63-4d69-9c8b-109206cb3f25":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/WildeBeere_50_UK_77343a37-5835-46fe-bab1-98b2ce205317.jpg","title":"Wild Berry","text":"<p>The perfect mix of sweet, fresh and fruitiness. Our Moonshine is infused with a combination of blackberry, raspberries & currants. Delicious! <\/p>","link_label":"","link":""}},"template--18049470005516__179d69e3-1373-40a2-92ff-f6e68918fbb5-column-1":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Toffee_50_UK.jpg","title":"Sticky Toffee","text":"<p>This one will instinctively remind you of the famous Sticky Toffee Pudding, just with a kick. Rich and smooth toffee flavour, perfected.<\/p>","link_label":"","link":""}}},"block_order":["template--18049470005516__179d69e3-1373-40a2-92ff-f6e68918fbb5-column-2","template--18049470005516__179d69e3-1373-40a2-92ff-f6e68918fbb5-column-3","87c4baff-6a63-4d69-9c8b-109206cb3f25","template--18049470005516__179d69e3-1373-40a2-92ff-f6e68918fbb5-column-1"],"settings":{"is_above_the_fold":false,"title":"","heading_size":"h1","image_width":"full","image_ratio":"adapt","columns_desktop":4,"column_alignment":"left","background_style":"primary","button_label":"","button_link":"","color_scheme":"background-1","columns_mobile":"1","swipe_on_mobile":true,"padding_top":36,"padding_bottom":36}},"dbc9186f-95f5-4922-a676-9a8c15ee5a7f":{"type":"multicolumn","blocks":{"template--18043048132876__dbc9186f-95f5-4922-a676-9a8c15ee5a7f-column-2":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Stills_Jule.png","title":"Greta","text":"<p>'Never heard of it before, but absolutely delicious. With the tasting box, you can try several varieties and discover your favourite.'<\/p>","link_label":"","link":""}},"template--18043048132876__dbc9186f-95f5-4922-a676-9a8c15ee5a7f-column-1":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Stills_Marc.png","title":"Harry","text":"<p>'Authentic flavours and definitely a unique design. A great box to get to know the brand.'<\/p>","link_label":"","link":""}},"template--18043048132876__dbc9186f-95f5-4922-a676-9a8c15ee5a7f-column-3":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Stills_Can.png","title":"Josh","text":"<p>'The box is fantastic for getting to know O'Donnell and its varieties. The flavours have completely convinced me. More of this, please!'<\/p>","link_label":"","link":""}}},"block_order":["template--18043048132876__dbc9186f-95f5-4922-a676-9a8c15ee5a7f-column-2","template--18043048132876__dbc9186f-95f5-4922-a676-9a8c15ee5a7f-column-1","template--18043048132876__dbc9186f-95f5-4922-a676-9a8c15ee5a7f-column-3"],"settings":{"is_above_the_fold":false,"title":"","heading_size":"h2","image_width":"full","image_ratio":"adapt","columns_desktop":3,"column_alignment":"center","background_style":"primary","button_label":"","button_link":"","color_scheme":"background-1","columns_mobile":"1","swipe_on_mobile":true,"padding_top":36,"padding_bottom":36}},"a524cd34-8f77-43c7-8eb3-82b5981c7dad":{"type":"image-with-text","blocks":{"template--18043048132876__a524cd34-8f77-43c7-8eb3-82b5981c7dad-heading-1":{"type":"heading","settings":{"heading":"Harte Nuss","heading_size":"h2"}},"template--18043048132876__a524cd34-8f77-43c7-8eb3-82b5981c7dad-text-1":{"type":"text","settings":{"text":"<p>Die Harte Nuss ist die unangefochtene Nummer Eins und unser Bestseller - natürlich nicht ohne Grund. Überzeug dich selber und werde zum Moonshiner.<\/p>","text_style":"body"}}},"block_order":["template--18043048132876__a524cd34-8f77-43c7-8eb3-82b5981c7dad-heading-1","template--18043048132876__a524cd34-8f77-43c7-8eb3-82b5981c7dad-text-1"],"disabled":true,"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"33f92ba6-6026-4162-8b31-1e815486233b":{"type":"image-with-text","blocks":{"template--18043048132876__33f92ba6-6026-4162-8b31-1e815486233b-heading-1":{"type":"heading","settings":{"heading":"Pralle Kirsche","heading_size":"h2"}},"template--18043048132876__33f92ba6-6026-4162-8b31-1e815486233b-text-1":{"type":"text","settings":{"text":"<p>Unsere \"Pralle Kirsche\" schmeckt wie frisch gepflückt vom Baum. Süß und vollmundig, dabei aber mit dem gewissem Etwas.<\/p>","text_style":"body"}}},"block_order":["template--18043048132876__33f92ba6-6026-4162-8b31-1e815486233b-heading-1","template--18043048132876__33f92ba6-6026-4162-8b31-1e815486233b-text-1"],"disabled":true,"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"4e1951f9-0f70-42fc-9336-47b25ceaeea2":{"type":"image-with-text","blocks":{"template--18043048132876__4e1951f9-0f70-42fc-9336-47b25ceaeea2-heading-1":{"type":"heading","settings":{"heading":"Passionsfrucht","heading_size":"h2"}},"template--18043048132876__4e1951f9-0f70-42fc-9336-47b25ceaeea2-text-1":{"type":"text","settings":{"text":"<p>Mit den tropischen Passionsfrüchten schlagen wir eine ganz neue Richtung in unserem Geschmacksportfolio ein und verbinden damit Moonshine-Tradition mit außergewöhnlichen Zutaten.<\/p>","text_style":"body"}}},"block_order":["template--18043048132876__4e1951f9-0f70-42fc-9336-47b25ceaeea2-heading-1","template--18043048132876__4e1951f9-0f70-42fc-9336-47b25ceaeea2-text-1"],"disabled":true,"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"83e0efff-664e-40a5-aba9-225de7ba316f":{"type":"image-with-text","blocks":{"template--18043048132876__83e0efff-664e-40a5-aba9-225de7ba316f-heading-1":{"type":"heading","settings":{"heading":"Wilde Beere","heading_size":"h2"}},"template--18043048132876__83e0efff-664e-40a5-aba9-225de7ba316f-text-1":{"type":"text","settings":{"text":"<p>Unsere \"Wilde Beere\" schmeckt wie frisch gesammelte Beeren aus dem Wald - einfach köstlich und lecker.<\/p>","text_style":"body"}}},"block_order":["template--18043048132876__83e0efff-664e-40a5-aba9-225de7ba316f-heading-1"