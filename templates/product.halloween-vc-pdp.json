{"sections":{"main":{"type":"main-product","blocks":{"title":{"type":"title","settings":{}},"caption":{"type":"text","settings":{"text":"{{ product.metafields.descriptors.subtitle.value }}","text_style":"subtitle"}},"8e29b3b3-eb8c-4755-aaec-d317609f4f19":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/star-rating\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}},"price":{"type":"price","settings":{}},"description":{"type":"description","settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button"}},"quantity_selector":{"type":"quantity_selector","settings":{}},"link_Qw9g6W":{"type":"link","settings":{"title":"Also available in a set of 3 and gift box!"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_sticky_cart":true,"is_set":false,"only_tier_gang_button":"Required gang tier not reached","set_size":3,"set_text":"Wähle 3 Produkte","show_dynamic_checkout":false,"gang_url":"https:\/\/odonnellmoonshine.co.uk\/account\/login"}},"wishlist_engine_product_page_6abfcf":{"type":"shopify:\/\/apps\/se-wishlist-engine\/blocks\/Product-Page\/8f7c0857-8e71-463d-a168-8e133094753b","disabled":true,"settings":{}},"6d5b98cf-5085-441e-8662-08829574072f":{"type":"shopify:\/\/apps\/klarna-on-site-messaging\/blocks\/app-block\/b95936a9-74b6-4a95-8103-6a1b6459c25e","settings":{"data_key":"credit-promotion-badge","theme":"light","topPadding":"0","bottomPadding":"2","messagePrefix":""}},"recommended_products_aGGUCA":{"type":"recommended_products","settings":{"title":"Customers' Favorites","content":"","button_text":"Add all to cart","product_list":["tough-nut","sticky-toffee","wild-berry"],"enable_bulk_add":false,"columns_desktop":"2","enable_desktop_slider":true,"columns_mobile":"2","swipe_on_mobile":true}},"collapsible_tab_4aakLU":{"type":"collapsible_tab","settings":{"heading":"Description","icon":"clipboard","content":"<p>Our Very Cherry<em> Moonshine<\/em> has embraced the spooky season! Enjoy the same rich, full cherry flavour with fine vanilla notes, a taste that’s hauntingly smooth and devilishly delicious. Each sip conjures up the warmth of long autumn nights, where cherries meet a hint of mischief. Perfect served on the rocks, in eerie cocktails, or shared with your favourite ghouls.<\/p><p>Discover cocktail recipes crafted to elevate your <em>Very Cherry Halloween Edition<\/em> on our <a href=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/very-cherry\" title=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/very-cherry\">cocktail<\/a> page.<\/p><p>Bottled in our signature Mason Jars, this limited-edition Moonshine promises a unique drinking experience that’s both playful and premium. <a href=\"https:\/\/odonnellmoonshine.co.uk\/collections\/moonshine\" title=\"https:\/\/odonnellmoonshine.co.uk\/collections\/moonshine\">Explore<\/a> our full range of liqueurs and join the <a href=\"https:\/\/odonnellmoonshine.co.uk\/pages\/gang\" title=\"https:\/\/odonnellmoonshine.co.uk\/pages\/gang\"><strong>Moonshine Gang <\/strong><\/a> to collect proof points and unlock exclusive treats, no tricks, we promise.<\/p>","page":""}},"collapsible_tab_pTXiwH":{"type":"collapsible_tab","settings":{"heading":"Perfect Serve","icon":"bottle","content":"<p><strong>Very Cherry - Halloween Edition<\/strong><\/p><ul><li>50ml Very Cherry<\/li><li>Top with Cola<\/li><li>Fresh Lime Slices<\/li><\/ul><p>Add Very Cherry to a tall glass with some ice. Top with Cola and 2 slices of fresh lime.<\/p><p>You can find more recipes on our <a href=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/very-cherry\" title=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/very-cherry\">cocktail blog<\/a>.<\/p>","page":""}},"collapsible_tab_TJyk4b":{"type":"collapsible_tab","settings":{"heading":"Allergen information","icon":"dairy_free","content":"<p>All of our Moonshines, unless indicated otherwise, are allergen free in accordance with Regulation (EU) No 1169\/2011 and amendments. All of our products, unless stated otherwise, are suitable for vegans and those with a gluten intolerance.<\/p><p>All of our spirits are produced using wheat based alcohol. While the distillation process removes gluten from the final product, individuals with certain conditions (i.e coeliac disease) may wish to exercise caution prior to purchase.<\/p>","page":""}},"collapsible_tab_iPwypF":{"type":"collapsible_tab","settings":{"heading":"Our Loyalty Scheme - The Gang","icon":"silhouette","content":"<p>Join our loyalty scheme 'The Gang' <a href=\"\/pages\/gang\" title=\"O'Donnell Gang\">here<\/a> to earn points, receive some amazing rewards and gain early access to exciting new products!<\/p>","page":""}},"collapsible-row-1":{"type":"collapsible_tab","settings":{"heading":"Shipping","icon":"truck","content":"<p><strong>£3.95 <\/strong>for orders <strong>&lt; <\/strong>2kg<br\/><strong>£5.95 <\/strong>for orders <strong>&gt; <\/strong>2kg<\/p><p><strong>Free shipping<\/strong> for orders over £70!<\/p><p>Shipping cost to Northern Ireland is set at £16.95<\/p>","page":""}}},"block_order":["title","caption","8e29b3b3-eb8c-4755-aaec-d317609f4f19","price","description","variant_picker","quantity_selector","link_Qw9g6W","buy_buttons","wishlist_engine_product_page_6abfcf","6d5b98cf-5085-441e-8662-08829574072f","recommended_products_aGGUCA","collapsible_tab_4aakLU","collapsible_tab_pTXiwH","collapsible_tab_TJyk4b","collapsible_tab_iPwypF","collapsible-row-1"],"custom_css":[".product__gang-badge {width: 23%;}"],"settings":{"gift_card_receipient_enabled":true,"is_above_the_fold":true,"enable_sticky_info":true,"badges_enabled":false,"gallery_layout":"thumbnail","media_size":"small","mobile_thumbnails":"hide","hide_variants":true,"enable_video_looping":false,"padding_top":24,"padding_bottom":12}},"image_with_text_fJTJCw":{"type":"image-with-text","blocks":{"heading_amJ78K":{"type":"heading","settings":{"heading":"Vampire's Choice","heading_size":"h2"}},"text_