yout":"thumbnail_slider","color_scheme":"background-1","secondary_background":false,"hide_variants":false,"enable_video_looping":false,"padding_top":36,"padding_bottom":36}},"image_with_text_LJ4LE8":{"type":"image-with-text","blocks":{"heading_6wbqNc":{"type":"heading","settings":{"heading":"Tough Nut Father's Day Edition","heading_size":"h2"}},"text_q9wV3P":{"type":"text","settings":{"text":"<p>From hardcore Moonshine fans to O'Donnell first timers, our Limited Edition Father's Day Tough Nut is the perfect way to raise a jar to dad this year. . <\/p><p>This Limited Edition jar features Father's Day messaging, making it the perfect personalised gift and a great collectors piece for Moonshine connoisseurs.<\/p>","text_style":"body"}},"button_gBGndV":{"type":"button","settings":{"button_label":"Shop Now!","button_link":"shopify:\/\/products\/limited-edition-fathers-day-tough-nut","button_style_white_color":false}}},"block_order":["heading_6wbqNc","text_q9wV3P","button_gBGndV"],"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image":"shopify:\/\/shop_images\/FathersDay1.jpg","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":12,"padding_bottom":12}},"6397b650-0e54-42cf-86d8-e16476f1e579":{"type":"image-with-text","blocks":{"template--17981283205388__6397b650-0e54-42cf-86d8-e16476f1e579-16860574813d2f6200-0":{"type":"heading","settings":{"heading":"Tough Nut Father's Day Hip Flask Bundle","heading_size":"h2"}},"template--17981283205388__6397b650-0e54-42cf-86d8-e16476f1e579-16860574813d2f6200-1":{"type":"text","settings":{"text":"<p>Treat Dad to the ultimate Father’s Day gift!<\/p><p>This bundle includes our Limited Edition Father’s Day Tough Nut, featuring exclusive messaging on the jar,and the best part? It also comes with a branded O’Donnell Hip Flask, so he can take his favourite flavour on the go. Cheers to that.<\/p>","text_style":"body"}},"6b4f5570-6f80-43d7-8e3d-1f0ab0c745e4":{"type":"button","settings":{"button_label":"Shop Now!","button_link":"shopify:\/\/products\/fathers-day-jar-hip-flask-bundle","button_style_white_color":false}}},"block_order":["template--17981283205388__6397b650-0e54-42cf-86d8-e16476f1e579-16860574813d2f6200-0","template--17981283205388__6397b650-0e54-42cf-86d8-e16476f1e579-16860574813d2f6200-1","6b4f5570-6f80-43d7-8e3d-1f0ab0c745e4"],"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image":"shopify:\/\/shop_images\/FathersDayBundle.jpg","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":12,"padding_bottom":12}},"rich_text_7aTLVC":{"type":"rich-text","blocks":{"heading_mXqEzE":{"type":"heading","settings":{"heading":"Our brand new flavour","heading_size":"h1"}}},"block_order":["heading_mXqEzE"],"disabled":true,"settings":{"color_scheme":"background-1","full_width":true,"padding_top":0,"padding_bottom":0}},"d677af4a-8a89-46e8-a238-6e193a45fcf8":{"type":"multicolumn","blocks":{"template--17981283205388__d677af4a-8a89-46e8-a238-6e193a45fcf8-1686057923c750a1da-2":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/NeueShotbox_Front_Offen_2.jpg","overlay_title":false,"overlay_title_position":"bottom","title":"Shot Box – The Ultimate Father’s Day Gift!","text":"<p>Treat Dad to something truly unique this Father's Day with our <strong>O'Donnell Moonshine Mini 24 x Shot Box<\/strong>. Each handcrafted wooden crate contains a selection of four 50ml moonshine shots! Whether he's a seasoned spirit lover or just up for a new adventure, this tasting set is a great way to show your appreciation.<\/p>","mobile_text":"","link_label":"Discover the Shot Box","link":"shopify:\/\/products\/odonnell-moonshine-shot-box","button_alignment":"left","selected_button":true,"grey_out_media":false}},"24daf74c-0ce7-42a5-8d98-a7831f1f3510":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/VeryCherry_GiftSet_UK.jpg","overlay_title":false,"overlay_title_position":"bottom","title":"Starter Kits - The Perfect Moonshine Introduction!","text":"<p>Our <strong>Starter Kits <\/strong>are the best way to introduce someone to the world of O’Donnell Moonshine. A set consisting of a 700ml Jar in the flavour of your choice and a Pouring Lid, so you don't lose a drop! All packaged in a stylish, open fronted gift box. With over 20 flavours to choose from, there's a perfect option to suit any taste!<\/p>","mobile_text":"","link_label":"Explore our Starter Kits","link":"shopify:\/\/products\/starter-kit-700ml","button_alignment":"left","selected_button":true,"grey_out_media":false}},"template--17981283205388__d677af4a-8a89-46e8-a238-6e193a45fcf8-1686057923c750a1da-1":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/GiftBox_Oben_UK_1500.jpg","overlay_title":false,"overlay_title_position":"bottom","title":"Gift Box -  Everything You Need in One Stylish Box!","text":"<p>Simply select any two of 10 possible Moonshine flavours to make up your perfect pair. Alongside your 2 x 700ml jars will be, two 50ml Mason Jar Shot Glasses and a Pouring Lid, soo you can achieve that perfect pour every time. Everything you need for a gift that's sure to bring a smile to dad's face - all boxed up and ready to wrap!<\/p>","mobile_text":"","link_label":"Shop the Gift box","link":"shopify:\/\/products\/giftbox","button_alignment":"left","selected_button":true,"grey_out_media":false}}},"block_order":["template--17981283205388__d677af4a-8a89-46e8-a238-6e193a45fcf8-1686057923c750a1da-2","24daf74c-0ce7-42a5-8d98-a7831f1f3510","template--17981283205388__d677af4a-8a89-46e8-a238-6e193a45fcf8-1686057923c750a1da-1"],"settings":{"is_above_the_fold":false,"title":"Find the perfect gift","heading_size":"h2","title_text":"","outer_padding":5,"image_width":"full","image_ratio":"adapt","image_border_color":"#ffffff","columns_desktop":3,"column_alignment":"left","background_style":"background-2","button_label":"","button_link":"","color_scheme":"background-1","columns_mobile":"1","swipe_on_mobile":true,"padding_top":12,"padding_bottom":12}},"image_with_text_ijYtha":{"type":"image-with-text","blocks":{"heading_qABYPY":{"type":"heading","settings":{"heading":"Triple the Celebration - The O'Donnell Set of 3","heading_size":"h2"}},"text_bczHPc":{"type":"text","settings":{"text":"<p>Father’s Day Gifting Sorted: The Set of Three Moonshines<\/p><p>Cool on the shelf and even better in a glass, build your own bundle with any 3 of dad’s favourite flavours.<\/p><p>You’ll save money, get 3 free pouring lids, and give the ultimate gift for Moonshine fans! <\/p>","text_style":"body"}},"button_WMWQWh":{"type":"button","settings":{"button_label":"Shop Now!","button_link":"shopify:\/\/products\/set3-700","button_style_white_color":false}}},"block_order":["heading_qABYPY","text_bczHPc","button_WMWQWh"],"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image":"shopify:\/\/shop_images\/NutSmash_UK.jpg","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":12,"padding_bottom":12}},"2f284470-c6bc-414d-ae73-ddc945a9928d":{"type":"yotpo-carousel-widget","settings":{"heading":"This is what our customers say...","heading_2":"","color_scheme":"background-1","font_size":26,"padding_top":0,"padding_bottom":12}},"multicolumn_eQMheP":{"type":"multicolumn","blocks":{"column_zy6Y9D":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Father_s_Day_Sq.jpg","overlay_title":false,"overlay_title_position":"bottom","title":"The O'Donnell's Gift Guide","text":"<p>With Father's day less than a month away, the race to find the perfect gift is officially on!<\/p>","mobile_text":"<p>With Father's day less than a month away, the race to find the perfect gift is officially on!<\/p>","link_label":"Read More","link":"shopify:\/\/blogs\/news\/the-odonnell-fathers-day-gift-guide-2025","button_alignment":"left","selected_button":false,"grey_out_media":false}},"column_nUgk8L":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/ODonnell_alles_von_uns_Hero_UK_mobil_39f1e740-b032-4c0e-b559-d917d34b5048.jpg","overlay_title":false,"overlay_title_position":"bottom","title":"What is Moonshine?","text":"<p>One of the most common questions we get asked at O'Donnell Moonshine is 'what is Moonshine', or even 'what is it made from?'<\/p>","mobile_text":"<p>One of the most common questions we get asked at O'Donnell Moonshine is 'what is Moonshine', or even 'what is it made from?'<\/p>","link_label":"","link":"","button_alignment":"left","selected_button":false,"grey_out_media":false}},"column_gbwtmE":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Daiquiri.png","overlay_title":false,"overlay_title_position":"bottom","title":"6 Classic Lime Cocktails","text":"<p>We’re celebrating bold citrus energy this summer, with the launch of our brand new Lime Moonshine!<\/p>","mobile_text":"<p>We’re celebrating bold citrus energy this summer, with the launch of our brand new Lime Moonshine!<\/p>","link_label":"","link":"","button_alignment":"left","selected_button":false,"grey_out_media":false}}},"block_order":["column_zy6Y9D","column_nUgk8L","column_gbwtmE"],"name":"t:sections.multicolumn.presets.name","settings":{"is_above_the_fold":false,"title":"Still need help?","heading_size":"h1","title_text":"","outer_padding":5,"image_width":"full","image_ratio":"adapt","image_border_color":"#fff","columns_desktop":3,"column_alignment":"left","background_style":"primary","button_label":"Check out our blog","button_link":"shopify:\/\/blogs\/news","color_scheme":"background-1","columns_mobile":"1","swipe_on_mobile":true,"padding_top":0,"padding_bottom":24}},"68bfb1a5-da3b-4e0b-a79b-3e0f6f33fa9b":{"type":"rich-text","blocks":{"template--18156992397580__68bfb1a5-da3b-4e0b-a79b-3e0f6f33fa9b-heading-1":{"type":"heading","settings":{"heading":"Gifting with style - by O'Donnell Moonshine","heading_size":"h2"}},"template--18156992397580__68bfb1a5-da3b-4e0b-a79b-3e0f6f33fa9b-text-1":{"type":"text","settings":{"text":"<p>Whatever the season, there is always reason enough to make your loved ones happy and we're providing the goods for you. If you're looking to give something special, look no further than <strong>O'Donnell Moonshine<\/strong>.<\/p><p><strong>What is O'Donnell Moonshine?<\/strong><br\/>Our Moonshine is <strong>more than just a drink<\/strong>. It's a piece of handcrafted perfection from the heart of the USA. The vibe of the prohibition has charmed our company distillers with the passion to create unique Moonshine. Each jar tells the story of a secretive handicraft which has been passed down for generations.<\/p>"}}},"block_order":["template--18156992397580__68bfb1a5-da3b-4e0b-a79b-3e0f6f33fa9b-heading-1","template--18156992397580__68bfb1a5-da3b-4e0b-a79b-3e0f6f33fa9b-text-1"],"disabled":true,"settings":{"color_scheme":"background-1","full_width":true,"padding_top":12,"padding_bottom":12}}},"order":["main","slideshow_jgEYDK","rich_text_NaWrpd","featured_collection_X99Yih","featured_product_nT9Bbq","image_with_text_LJ4LE8","6397b650-0e54-42cf-86d8-e16476f1e579","rich_text_7aTLVC","d677af4a-8a89-46e8-a238-6e193a45fcf8","image_with_text_ijYtha","2f284470-c6bc-414d-ae73-ddc945a9928d","multicolumn_eQMheP","68bfb1a5-da3b-4e0b-a79b-3e0f6f33fa9b"]}