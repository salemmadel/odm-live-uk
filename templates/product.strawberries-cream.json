{"sections":{"main":{"type":"main-product","blocks":{"title":{"type":"title","settings":{}},"caption":{"type":"text","settings":{"text":"{{ product.metafields.descriptors.subtitle.value }}","text_style":"subtitle"}},"518e9061-ed9f-42d1-ae44-cf5200aee6c8":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/star-rating\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}},"price":{"type":"price","settings":{}},"description":{"type":"description","settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button"}},"fd35310f-a903-4f2a-aa78-92f345583144":{"type":"link","settings":{"title":"{{ product.metafields.custom.link_to_title.value }}"}},"quantity_selector":{"type":"quantity_selector","settings":{}},"buy_buttons":{"type":"buy_buttons","settings":{"show_sticky_cart":true,"is_set":false,"only_tier_gang_button":"Required gang tier not reached","set_size":0,"set_text":"","show_dynamic_checkout":false,"gang_url":"https:\/\/odonnellmoonshine.co.uk\/account\/login"}},"wishlist_engine_product_page_BJc4tT":{"type":"shopify:\/\/apps\/se-wishlist-engine\/blocks\/Product-Page\/8f7c0857-8e71-463d-a168-8e133094753b","disabled":true,"settings":{}},"97ce63d9-5477-4fed-a92a-335ffa45b484":{"type":"shopify:\/\/apps\/klarna-on-site-messaging\/blocks\/app-block\/b95936a9-74b6-4a95-8103-6a1b6459c25e","settings":{"data_key":"credit-promotion-badge","theme":"light","topPadding":"0","bottomPadding":"0","messagePrefix":""}},"recommended_products_B9cNFb":{"type":"recommended_products","settings":{"title":"The Perfect Gifting","content":"","button_text":"Add all to cart","product_list":["starter-kit-700ml","strawberry-rhubarb"],"enable_bulk_add":false,"columns_desktop":"2","enable_desktop_slider":false,"columns_mobile":"2","swipe_on_mobile":false}},"collapsible-row-2":{"type":"collapsible_tab","settings":{"heading":"Description","icon":"clipboard","content":"<p><strong>Fresh strawberries and indulgent cream! The ultimate summer pairing.<br\/><\/strong>Our Strawberries & Cream Moonshine is the perfect sip for sunny evenings, barbecues, picnics, or parties. With its velvety texture and rich strawberry aroma, it’s a treat that brings something special to any occasion.<\/p><p><strong>Effortlessly crowd-pleasing — it’s summer in a jar.<\/strong><\/p><p>Bottled in traditional Mason Jars, we promise a unique drinking experience. If you would like to discover <a href=\"https:\/\/odonnellmoonshine.co.uk\/collections\/moonshine\">more high quality liqueurs<\/a>, have a look at our entire product range. Become part of our <a href=\"https:\/\/odonnellmoonshine.co.uk\/pages\/gang\" title=\"O'Donnell Gang\">Moonshine Gang<\/a> to collect proof points and unlock unique benefits.<\/p><p>For those new to Moonshine, it was the name given to illegally produced grain alcohol distilled during the American Prohibition. It was traditionally bottled in Mason Jars to avoid detection by the authorities. O’Donnell Moonshine retains the rebellious nature of that era, while delivering a whole new world of flavour in our range of smooth and delicious liqueurs.<\/p><h5>*Consult our <a href=\"https:\/\/odonnellmoonshine.co.uk\/pages\/faq\">FAQ's<\/a> for more information.<\/h5>","page":""}},"collapsible-row-3":{"type":"collapsible_tab","settings":{"heading":"Perfect Serve","icon":"bottle","content":"<h3>Neat Over Ice<\/h3><p>50ml Strawberries & Cream<br\/>Ice Cubes<\/p><p>Add ice to a short glass, then fill with as much <em>Strawberries & Cream<\/em> as desired. Serve and enjoy!<\/p><p>You can find more recipes in our <a href=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\"><span style=\"text-decoration:underline\">Cocktails-Blog<\/span><\/a>.<\/p>","page":""}},"29562b2d-d73d-4a10-83aa-0c0922c0fbca":{"type":"collapsible_tab","settings":{"heading":"Allergens and additional information","icon":"dairy_free","content":"<p><strong>Contains milk & dairy products!<\/strong><\/p><p>All of our spirits are produced using wheat based alcohol. While the distillation process removes gluten from the final product, individuals with certain conditions (i.e coeliac disease) may wish to exercise caution prior to purchase.<\/p><p>Contains colourant (E129)<\/p>","page":""}},"collapsible-row-1":{"type":"collapsible_tab","settings":{"heading":"Our Loyalty Scheme - The Gang","icon":"silhouette","content":"<p>Join our loyalty scheme 'The Gang' <a href=\"\/pages\/gang\" title=\"O'Donnell Gang\">here<\/a> to earn points, receive some amazing rewards and gain early access to exciting new products!<\/p>","page":""}},"08a702ee-31b7-4e82-b9f9-90592e4d2eff":{"type":"collapsible_tab","settings":{"heading":"Moonshine Must-Haves","icon":"check_mark","content":"<p>1. Your jar of <a href=\"\/collections\/moonshine\" title=\"Moonshine\">Moonshine<\/a>.<\/p><p>2. Our reusable <a href=\"\/products\/pouring-lid\" title=\"Pouring Lid\">Pouring Lid<\/a> to not waste a drop.<\/p>","page":""}},"collapsible-row-0":{"type":"collapsible_tab","settings":{"heading":"Shipping","icon":"truck","content":"<p><strong>£3.95 <\/strong>for orders <strong>&lt; <\/strong>2kg<br\/><strong>£5.95 <\/strong>for orders <strong>&gt; <\/strong>2kg<\/p><p><strong>Free shipping<\/strong> for orders over £70!<\/p><p>Shipping cost to Northern Ireland is set at £16.95<\/p>","page":""}}},"block_order":["title","caption","518e9061-ed9f-42d1-ae44-cf5200aee6c8","price","description","variant_picker","fd35310f-a903-4f2a-aa78-92f345583144","quantity_selector","buy_buttons","wishlist_engine_product_page_BJc4tT","97ce63d9-5477-4fed-a92a-335ffa45b484","recommended_products_B9cNFb","collapsible-row-2","collapsible-row-3","29562b2d-d73d-4a10-83aa-0c0922c0fbca","collapsible-row-1","08a702ee-31b7-4e82-b9f9-90592e4d2eff","collapsible-row-0"],"settings":{"gift_card_receipient_enabled":false,"is_above_the_fold":true,"enable_sticky_info":true,"badges_enabled":false,"gallery_layout":"thumbnail","media_size":"small","mobile_thumbnails":"hide","hide_variants":true,"enable_vi