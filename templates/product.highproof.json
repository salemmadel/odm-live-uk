{"sections":{"main":{"type":"main-product","blocks":{"title":{"type":"title","settings":{}},"caption":{"type":"text","settings":{"text":"{{ product.metafields.descriptors.subtitle.value }}","text_style":"subtitle"}},"9eaffe6f-54f0-4193-a98a-1d20cbd97572":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/star-rating\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}},"price":{"type":"price","settings":{}},"description":{"type":"description","settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button"}},"da8ef1d6-d5ee-4fd6-a726-7c6359134946":{"type":"link","settings":{"title":"{{ product.metafields.custom.link_to_title.value }}"}},"quantity_selector":{"type":"quantity_selector","settings":{}},"buy_buttons":{"type":"buy_buttons","settings":{"show_sticky_cart":true,"is_set":false,"only_tier_gang_button":"Required gang tier not reached","set_size":3,"set_text":"Wähle 3 Produkte","show_dynamic_checkout":false,"gang_url":""}},"wishlist_engine_product_page_TpXeBL":{"type":"shopify:\/\/apps\/se-wishlist-engine\/blocks\/Product-Page\/8f7c0857-8e71-463d-a168-8e133094753b","disabled":true,"settings":{}},"44709862-1cf8-4244-915f-b844042c4ba4":{"type":"shopify:\/\/apps\/klarna-on-site-messaging\/blocks\/app-block\/b95936a9-74b6-4a95-8103-6a1b6459c25e","settings":{"data_key":"credit-promotion-badge","theme":"light","topPadding":"0","bottomPadding":"0","messagePrefix":""}},"recommended_products_YizaMC":{"type":"recommended_products","settings":{"title":"The Prefect Gifting","content":"","button_text":"","product_list":["sweet-treats-gift-box","aperitivo"],"enable_bulk_add":false,"columns_desktop":"2","enable_desktop_slider":false,"columns_mobile":"2","swipe_on_mobile":false}},"collapsible-row-2":{"type":"collapsible_tab","settings":{"heading":"Description","icon":"clipboard","content":"<p>The traditional Moonshine. Widely known for its <strong>high alcohol<\/strong> content of 50% ABV (100 proof). Immense character, with the typical sharpness of <strong>high percent spirits<\/strong> but with one of the smoothest finishes we have experienced. A liquor that would make our Namesake Spike O’Donnell proud.<\/p><p>If you like <strong>Vodka, <\/strong>you are going to love our High Proof Moonshine. We recommend to sip it ice-cold or use it for example in a Moonshine Mule. Check out all our <a href=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/high-proof\" title=\"O'Donnell High Proof Cocktails\">High Proof cocktail recipe<\/a> and ideas for inspiration.<\/p><p>Bottled in traditional Mason Jars, we promise a unique drinking experience. If you would like to discover <a href=\"https:\/\/odonnellmoonshine.co.uk\/collections\/moonshine\">more high quality liqueurs,<\/a> have a look at our entire product range and become part of our <a href=\"https:\/\/odonnellmoonshine.co.uk\/pages\/gang\">Moonshine Gang<\/a> to collect proof points and get unique benefits.<\/p><p>Curious? Simply order your High Proof today online and we will ship the product anywhere in mainland UK within a few working days.<\/p>","page":""}},"collapsible-row-3":{"type":"collapsible_tab","settings":{"heading":"Perfect Serve","icon":"bottle","content":"<p><strong>High Proof & Tonic<\/strong><\/p><ul><li>50ml High Proof<\/li><li>Top with Tonic Water<\/li><li>Fresh Lemon Slices<br\/><\/li><\/ul><p>Add High Proof to a tall glass with some ice. Top with Tonic Water and 2 slices of fresh lemon. <\/p><p>You can find more recipes on our <a href=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/high-proof\" title=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/high-proof\">cocktail page<\/a>.<\/p>","page":""}},"collapsible-row-1":{"type":"collapsible_tab","settings":{"heading":"Our Loyalty Scheme - The Gang","icon":"silhouette","content":"<p>Join our loyalty scheme 'The Gang' <a href=\"https:\/\/odonnellmoonshine.co.uk\/pages\/gang\" title=\"https:\/\/odonnellmoonshine.co.uk\/pages\/gang\">here<\/a> to earn points, receive some amazing rewards and gain early access to exciting new products!<\/p>","page":""}},"ac998993-6dbe-411d-ba9a-aa6abc9b13f2":{"type":"collapsible_tab","settings":{"heading":"Allergens","icon":"nut_free","content":"<p>All of our Moonshines, unless indicated otherwise, are allergen free in accordance with Regulation (EU) No 1169\/2011 and amendments. All of our products are suitable for vegans and those with a gluten intolerance.<\/p><p>All of our spirits are produced using wheat based alcohol. While the distillation process removes gluten from the final product, individuals with certain conditions (i.e coeliac disease) may wish to exercise caution prior to purchase.<\/p>","page":""}},"collapsible-row-0":{"type":"collapsible_tab","settings":{"heading":"Shipping","icon":"truck","content":"<p><strong>£3.95 <\/strong>for orders <strong>&lt; <\/strong>2kg<br\/><strong>£5.95 <\/strong>for orders <strong>&gt; <\/strong>2kg<\/p><p><strong>Free shipping<\/strong> for orders over £70!<\/p><p>Shipping cost to Northern Ireland is set at £16.95<\/p>","page":""}}},"block_order":["title","caption","9eaffe6f-54f0-4193-a98a-1d20cbd97572","price","description","variant_picker","da8ef1d6-d5ee-4fd6-a726-7c6359134946","quantity_selector","buy_buttons","wishlist_engine_product_page_TpXeBL","44709862-1cf8-4244-915f-b844042c4ba4","recommended_products_YizaMC","collapsible-row-2","collapsible-row-3","collapsible-row-1","ac998993-6dbe-411d-ba9a-aa6abc9b13f2","collapsible-row-0"],"settings":{"gift_card_receipient_enabled":false,"is_above_the_fold":true,"enable_sticky_info":true,"badges_enabled":false,"gallery_layout":"thumbnail","media_size":"small","mobile_thumbnails":"hide","hide_variants":true,"enable_video_looping":false,"padding_top":24,"padding_bottom":12}},"image-with-text":{"type":"image-with-text","blocks":{"image-with-text-0":{"type":"heading","settings":{"heading":"The Original Moonshine","heading_size":"h2"}},"image-with-text-1":{"type":"text","settings":{"text":"<p>Our High Proof spirit,  made in the tradition of authentic Prohibition era Moonshine, retains the distinct sharpness often found in high-proof beverages. However, with it's unbelievably smooth finish, courtesy of our high quality ingredients and triple distillation process, O'Donnell Moonshine High Proof is sure to surprise and delight.<\/p>","text_style":"body"}}},"block_order":["image-with-text-0","image-with-text-1"],"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image":"shopify:\/\/shop_images\/HP_NEW.jpg","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"23e006b4-fd22-451f-8cb1-866814242740":{"type":"image-with-text","blocks":{"92d981c0-0c40-4a72-8b36-618a60a835c1":{"type":"heading","settings":{"heading":"The Perfect Addition to Any Cocktail","heading_size":"h2"}},"a40f2009-4d6a-40a2-a339-53b396f31c98":{"type":"text","settings":{"text":"<p>True to the cocktail tradition of Prohibition era Moonshine, High Proof is an exceptionally versatile spirit that adds a strong, smooth kick to many of your favourite cocktails. Find some inspiration <a href=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/high-proof\" title=\"https:\/\/odonnellmoonshine.co.uk\/blogs\/cocktails\/tagged\/high-proof\">here<\/a>.<\/p>","text_style":"body"}}},"block_order":["92d981c0-0c40-4a72-8b36-618a60a835c1","a40f2009-4d6a-40a2-a339-53b396f31c98"],"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image":"shopify:\/\/shop_images\/Copy_of_WatermelonSummerHigh_square_1500.jpg","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"24dc32c6-c1be-4495-861e-3b82eddceb91":{"type":"image-with-text","blocks":{"7ba35540-0a10-44c7-abe5-3fbca7db13dc":{"type":"heading","settings":{"heading":"Strong and Smooth","heading_size":"h2"}},"e6af3c40-7e3a-4c3d-8c8f-457cf27cbe07":{"type":"text","settings":{"text":"<p>Filtered and triple distilled for the ultimate smoothness and clarity, High Proof offers an 'authentic' Moonshine experience with unmatched quality, worthy of Spike O'Donnell himself!<\/p>","text_style":"body"}}},"block_order":["7ba35540-0a10-44c7-abe5-3fbca7db13dc","e6af3c40-7e3a-4c3d-8c8f-457cf27cbe07"],"settings":{"is_above_the_fold":false,"background_color":"#ffffff","text_color":"#000000","image":"shopify:\/\/shop_images\/Untitled_design_71.png","image_caption":"","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"left","content_layout":"overlap","color_scheme":"background-2","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"product-recommendations":{"type":"product-recommendations","settings":{"heading":"You might also like","heading_size":"h2","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"square","show_secondary_image":true,"show_vendor":false,"show_rating":false,"grey_sold_out_products":true,"columns_mobile":"2","padding_top":36,"padding_bottom":28}},"1686907215cb88c167":{"type":"apps","blocks":{"f127af48-3df5-423d-9541-80185dc1ed9d":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/reviews\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}}},"block_order":["f127af48-3df5-423d-9541-80185dc1ed9d"],"settings":{"include_margins":true}}},"order":["main","image-with-text","23e006b4-fd22-451f-8cb1-866814242740","24dc32c6-c1be-4495-861e-3b82eddceb91","product-recommendations","1686907215cb88c167