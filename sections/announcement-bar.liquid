{%- style -%}
   .announcement-bar-color-palette {
    background: {{section.settings.background_color_special }};
    color: {{section.settings.heading_color_special }};
  }
  .announcement-bar-color-palette .announcement-bar__message {
    color: {{section.settings.heading_color_special }} ;
  }
{%- endstyle -%}

{%- comment -%} Wrap the slider in a conditional to only show if the static option is not selected {%- endcomment -%}
{%- if section.settings.make_static == false -%}
  <div class="announcement-bar-swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'announcement' -%}
          {%- if block.settings.text != blank or block.settings.html_content != blank -%}
            <div class="swiper-slide">
              <div class="announcement-bar {% if section.settings.apply_special_colors%}announcement-bar-color-palette {% else %}color-{{ block.settings.color_scheme }} gradient {% endif %}" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
                {%- endif -%}
                  {%- if block.settings.html_content != blank -%}
                    <div class="announcement-bar__message h5">
                      {{ block.settings.html_content }}
                    </div>
                  {%- else -%}
                    <p class="announcement-bar__message h5">
                      {{ block.settings.text | escape }}

                      {%- comment -%} Conditionally hide the arrow {%- endcomment -%}
                      {%- if block.settings.link != blank and section.settings.hide_arrow == false -%}
                        {% render 'icon-arrow' %}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
  {%- for block in section.blocks limit: 1 -%}
    {%- case block.type -%}
      {%- when 'announcement' -%}
      {%- if block.settings.text != blank or block.settings.html_content != blank -%}
          <div class="swiper-slide">
            <div class="announcement-bar {% if section.settings.apply_special_colors%}announcement-bar-color-palette {% else %}color-{{ block.settings.color_scheme }} gradient {% endif %}" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
              {%- endif -%}
                {%- if block.settings.html_content != blank -%}
                  <div class="announcement-bar__message h5">
                    {{ block.settings.html_content }}
                  </div>
                {%- else -%}
                  <p class="announcement-bar__message h5">
                    {{ block.settings.text | escape }}

                    {%- comment -%} Conditionally hide the arrow {%- endcomment -%}
                    {%- if block.settings.link != blank and section.settings.hide_arrow == false -%}
                      {% render 'icon-arrow' %}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          </div>
      {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Conditionally render the Swiper script only if the bar is not static {%- endcomment -%}
{%- if section.settings.make_static == false -%}
  <script>
    const swiper = new Swiper('.announcement-bar-swiper', {
      // Optional parameters
      loop: true,
      slidesPerView: 1,
      autoplay: {
        autoHeight: true,
        delay: {{ section.settings.slider_speed }},
        disableOnInteraction: {{ section.settings.autoplay_stop_on_interaction }},
      },
    })
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
      "id": "make_static",
      "label": "Make announcement bar static",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_arrow",
      "label": "Hide arrow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay_stop_on_interaction",
      "label": "Stops Autoplay on Interaction",
      "default": false
    },
    {
      "type": "number",
      "id": "slider_speed",
      "label": "Slider Speed",
      "default": 2500
    },
    {
      "type": "checkbox",
      "id": "apply_special_colors",
      "label": "Apply special color-palette",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color_special",
      "label": "t:sections.announcement-bar.settings.background_color_special.label",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color_special",
      "label": "t:sections.announcement-bar.settings.heading_color_special.label",
      "default": "#FFFFFF"
    }
    
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "html",
          "id": "html_content",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.liquid.label"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "options": [
            {
              "value": "accent-1",
              "label": "t:sections.all.colors.accent_1.label"
            },
            {
              "value": "accent-2",
              "label": "t:sections.all.colors.accent_2.label"
            },
            {
              "value": "background-1",
              "label": "t:sections.all.colors.background_1.label"
            },
            {
              "value": "background-2",
              "label": "t:sections.all.colors.background_2.label"
            },
            {
              "value": "inverse",
              "label": "t:sections.all.colors.inverse.label"
            }
          ],
          "default": "accent-1",
          "label": "t:sections.all.colors.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}